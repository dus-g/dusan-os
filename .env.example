# Neon PostgreSQL — use the POOLED string for DATABASE_URL and the DIRECT string for migrations
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/dusanos?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxxx.ap-southeast-2.aws.neon.tech/dusanos?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# Public URL of the app (used in password-reset emails)
APP_URL="http://localhost:3000"

# Optional: Resend for password-reset emails. Without it, reset links are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Dusan OS <no-reply@yourdomain.com>"

# Optional: PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Seed user (npm run db:seed)
SEED_EMAIL="dusan@example.com"
SEED_PASSWORD="change-me-please"
# Set to 1 to add ~6 weeks of example shifts when seeding (handy for a demo; skip for real use)
SEED_SAMPLE="0"
